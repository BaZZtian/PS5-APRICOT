// Original compute rasterizer. Input triangles are natively clipped once on CPU.
#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(std430,binding=0) readonly buffer Input {uint words[];};
layout(std430,binding=2) buffer Status {uint unsupported;};
layout(std430,binding=3) writeonly buffer Work {uint frame[];};
const uint plane=256u*192u;
