        if(polygon_alpha==0) {if(distance>0.75)continue;polygon_alpha=31;}
        vec2 st=vec2(dot(vec3(number(t+16),number(t+52),number(t+88)),bary),dot(vec3(number(t+20),number(t+56),number(t+92)),bary))/divisor;
        uvec3 vertex=uvec3(clamp(vec3(dot(vec3(number(t+24),number(t+60),number(t+96)),bary),
            dot(vec3(number(t+28),number(t+64),number(t+100)),bary),dot(vec3(number(t+32),number(t+68),number(t+104)),bary))/divisor,0.0,63.0));
